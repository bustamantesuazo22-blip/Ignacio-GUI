-- ─── Helpers ─────────────────────────────────────────
local function buildColorSequence(slots)
    if #slots == 0 then return ColorSequence.new(Color3.new(1,1,1)) end
    if #slots == 1 then return ColorSequence.new(slots[1]) end
    local kp = {}
    for i, c in ipairs(slots) do
        kp[i] = ColorSequenceKeypoint.new((i-1) / (#slots-1), c)
    end
    return ColorSequence.new(kp)
end

local function updateAttachmentsPositions()
    if not currentAttachments then return end
    local a0, a1 = currentAttachments[1], currentAttachments[2]
    if not a0 or not a1 then return end
    local half = trailHeightSpan * 0.5
    a0.Position = Vector3.new(0, trailCenterY + half, -0.10)
    a1.Position = Vector3.new(0, trailCenterY - half, -0.10)
end

local function updateTrailTransparency()
    if not currentTrail then return end
    -- Transparencia usa NumberSequence; mantenemos la nitidez hasta 98%
    currentTrail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, trailTransparencyGlobal),
        NumberSequenceKeypoint.new(0.98, trailTransparencyGlobal),
        NumberSequenceKeypoint.new(1, 1.0)
    })
end

-- ─── Trail Attachment ────────────────────────────────
local function attachTrail(char)
    if currentTrail then
        pcall(function() currentTrail:Destroy() end)
        currentTrail = nil
        currentAttachments = nil
    end

    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    if not torso then return end

    for _, v in ipairs(torso:GetChildren()) do
        if v.Name:sub(1,4) == "_TFX" then v:Destroy() end
    end

    local a0 = Instance.new("Attachment")
    a0.Name    = "_TFX_a0"
    local half = trailHeightSpan * 0.5
    a0.Position = Vector3.new(0, trailCenterY + half, -0.10)
    a0.Parent   = torso

    local a1 = Instance.new("Attachment")
    a1.Name    = "_TFX_a1"
    a1.Position = Vector3.new(0, trailCenterY - half, -0.10)
    a1.Parent   = torso

    local trail = Instance.new("Trail")
    trail.Name           = "_TFX_Trail"
    trail.Attachment0    = a0
    trail.Attachment1    = a1
    trail.Lifetime       = 0.75
    trail.FaceCamera     = false
    trail.MinLength      = 0.1  
    trail.LightEmission  = 0.0
    trail.LightInfluence = 0.0  
    trail.Enabled        = true
    trail.Texture        = ""

    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, trailWidthGlobal),
        NumberSequenceKeypoint.new(0.98, trailWidthGlobal),
        NumberSequenceKeypoint.new(1, trailWidthGlobal * 0.05)
    })
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, trailTransparencyGlobal),
        NumberSequenceKeypoint.new(0.98, trailTransparencyGlobal),
        NumberSequenceKeypoint.new(1, 1.0)
    })

    trail.Color           = currentColorSeq
    trail.Parent          = torso
    currentTrail          = trail
    currentAttachments    = {a0, a1}
end

local function onCharacter(char)
    task.wait(0.5)
    attachTrail(char)
end

