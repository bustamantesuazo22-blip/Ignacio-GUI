-- Lógica del Selector de Color
local draggingWheel, draggingBright = false, false
local function applyWheel(pos)
    local ap, as = wheelCanvas.AbsolutePosition, wheelCanvas.AbsoluteSize
    local dx, dy = pos.X - (ap.X + as.X/2), pos.Y - (ap.Y + as.Y/2)
    H = (math.atan2(-dy, dx) / (2*math.pi) + 1) % 1
    S = math.clamp(math.sqrt(dx*dx + dy*dy) / WR, 0, 1)
    local angle, r = H * 2 * math.pi, S * WR
    wCursor.Position = UDim2.new(0, math.cos(angle)*r + WR-5, 0, -math.sin(angle)*r + WR-5)
    updatePendingColor()
end

local function applyBrightness(pos)
    local ap, as = bBar.AbsolutePosition, bBar.AbsoluteSize
    V = 1 - math.clamp((pos.Y - ap.Y) / as.Y, 0, 1)
    bHandle.Position = UDim2.new(0, -2, 0, (1-V)*(WSIZE-6))
    updatePendingColor()
end

wheelCanvas.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingWheel = true; applyWheel(inp.Position) end end)
bBar.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingBright = true; applyBrightness(inp.Position) end end)
UserInputService.InputChanged:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseMovement then if draggingWheel then applyWheel(inp.Position) elseif draggingBright then applyBrightness(inp.Position) end end end)
UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then draggingWheel, draggingBright = false, false end end)

