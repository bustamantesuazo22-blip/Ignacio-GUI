    if draggingSlider then
        local pct = math.clamp((inp.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
        sliderKnob.Position = UDim2.new(pct, -7, 0.5, -7)
