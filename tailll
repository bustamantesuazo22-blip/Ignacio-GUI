RunService.Heartbeat:Connect(function(dt)
    if currentTrail and currentTrail.Parent then
        pcall(function()
            currentTrail.WidthScale = NumberSequence.new({
                NumberSequenceKeypoint.new(0, trailWidthGlobal),
                NumberSequenceKeypoint.new(0.98, trailWidthGlobal), 
                NumberSequenceKeypoint.new(1, trailWidthGlobal * 0.05)
            })
            -- Transparencia ya actualizada en updateTrailTransparency() cuando se mueve el slider
        end)
        
        currentTrail.LightEmission  = 0.0
        currentTrail.LightInfluence = 0.0

        if isLimited and #colorSlots > 1 then
            shiftTime = (shiftTime + dt * 1.5) % 1
            local rawPoints = {}
            for i, color in ipairs(colorSlots) do
                local relativeTime = ((i - 1) / (#colorSlots - 1) + shiftTime) % 1
                table.insert(rawPoints, {t = relativeTime, c = color})
            end
            table.sort(rawPoints, function(a, b) return a.t < b.t end)

            local keypoints = {}
            table.insert(keypoints, ColorSequenceKeypoint.new(0, rawPoints[#rawPoints].c))
            for _, pt in ipairs(rawPoints) do
                if pt.t > 0.001 and pt.t < 0.999 then
                    table.insert(keypoints, ColorSequenceKeypoint.new(pt.t, pt.c))
                end
            end
            table.insert(keypoints, ColorSequenceKeypoint.new(1, rawPoints[1].c))

            local cleanKps = {}
            local lastT = -1
            for _, kp in ipairs(keypoints) do
                if kp.Time - lastT > 0.006 or kp.Time == 0 or kp.Time == 1 then
                    table.insert(cleanKps, kp)
                    lastT = kp.Time
                end
            end
            if #cleanKps < 2 then table.insert(cleanKps, ColorSequenceKeypoint.new(1, rawPoints[1].c)) end

            pcall(function() currentTrail.Color = ColorSequence.new(cleanKps) end)
            currentTrail.Lifetime = 0.75
        else
            currentTrail.Lifetime = 0.75
        end
    end
end)

