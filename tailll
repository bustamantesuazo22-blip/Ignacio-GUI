        -- Mapeo: pct = 0 (izq) => trail transparente (1.0), pct = 1 (der) => opaco (0.0)
        trailTransparencyGlobal = 1.0 - pct
        updateTrailTransparency()
    elseif draggingOp then
        local pct = math.clamp((inp.Position.X - opBar.AbsolutePosition.X) / opBar.AbsoluteSize.X, 0, 1)
        opKnob.Position = UDim2.new(pct, -7, 0.5, -7)
        opFill.Size = UDim2.new(pct, 0, 1, 0)
        -- Mapeo: pct -> span entre minSpan .. maxSpan (maxSpan = doble del por defecto)
        trailHeightSpan = minSpan + pct * (maxSpan - minSpan)
        updateAttachmentsPositions()
    end
end)

