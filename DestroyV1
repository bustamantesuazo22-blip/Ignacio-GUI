-- 2. God Mode invencible con aura dorada (el nuestro)
task.spawn(function()
    local player = game.Players.LocalPlayer

    local function enableGodMode(character)
        local humanoid = character:WaitForChild("Humanoid")
        
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        
        humanoid.HealthChanged:Connect(function()
            humanoid.Health = math.huge
        end)
        
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        
        local root = character:WaitForChild("HumanoidRootPart")
        local attach = Instance.new("Attachment", root)
        local particles = Instance.new("ParticleEmitter", attach)
        particles.Texture = "rbxassetid://241353019"
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255))
        particles.Lifetime = NumberRange.new(1, 3)
        particles.Rate = 100
        particles.Speed = NumberRange.new(3, 8)
        particles.SpreadAngle = Vector2.new(360, 360)
        particles.LightEmission = 1
        particles.ZOffset = 1
        particles.Enabled = true
        
        print("GOD MODE ACTIVADO, ERES INVENCIBLE, CABRÓN")
    end

    if player.Character then
        enableGodMode(player.Character)
    end
    player.CharacterAdded:Connect(enableGodMode)
end)

