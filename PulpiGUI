-- ==========================================
-- [ NDS: SOLIDIFY NUEVAS PIEZAS SIN LAG ]
-- Solo activo en Natural Disaster Survival (189707)
-- Cola + batch con puntero: sin table.remove costoso.
-- Anchored = true  +  CanCollide = true por cada parte.
-- ==========================================
if game.PlaceId == 189707 then

    -- Lookup O(1) de personajes — evita iterar jugadores por cada parte
    local _charModels = {}
    local function _trackPlayer(p)
        p.CharacterAdded:Connect(function(c)
            _charModels[c] = true
            c.AncestryChanged:Connect(function()
                if not c.Parent then _charModels[c] = nil end
            end)
        end)
        if p.Character then _charModels[p.Character] = true end
    end
    for _, p in pairs(Players:GetPlayers()) do _trackPlayer(p) end
    Players.PlayerAdded:Connect(_trackPlayer)
    Players.PlayerRemoving:Connect(function(p)
        if p.Character then _charModels[p.Character] = nil end
    end)

    -- Cola con puntero de lectura: no hace table.remove → O(1) por operación
    local _ndsQueue  = {}
    local _ndsHead   = 1   -- próxima posición a leer
    local _ndsTail   = 0   -- última posición escrita

    -- Encola TODAS las BaseParts nuevas sin ningún filtro aquí
    Workspace.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") then
            _ndsTail = _ndsTail + 1
            _ndsQueue[_ndsTail] = obj
        end
    end)

    -- Procesador: cada Heartbeat, máximo 40 partes
    -- Sin throttle de tiempo para reaccionar lo más rápido posible
    local _NDS_BATCH = 40

    RunService.Heartbeat:Connect(function()
        if _ndsHead > _ndsTail then return end

        local processed = 0
        while _ndsHead <= _ndsTail and processed < _NDS_BATCH do
            local part = _ndsQueue[_ndsHead]
            _ndsQueue[_ndsHead] = nil  -- liberar referencia (GC)
            _ndsHead = _ndsHead + 1
            processed = processed + 1

            if part and part.Parent then
                -- ¿Es parte de un personaje? lookup O(1)
                local model = part:FindFirstAncestorOfClass("Model")
                if not (model and _charModels[model]) then
                    -- Solidificar: anclada Y con colisión
                if not _G.PULPI_partsToolActive then
                    pcall(function()
                        part.Anchored   = true
                        part.CanCollide = true
                    end)
                end
                end
            end
        end

        -- Resetear punteros cuando la cola se vacía para evitar tabla infinita
        if _ndsHead > _ndsTail then
            _ndsQueue = {}
            _ndsHead  = 1
            _ndsTail  = 0
        end
    end)
end

