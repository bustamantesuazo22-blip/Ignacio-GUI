                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end)
    end
end


local huntTarget = nil
local huntHighlight = nil
local huntBeam = nil
local att0, att1 = nil, nil
local hunting = false

-- ★ HUNT RING: piezas sueltas lanzadas al target (misma mecánica que ForcePart del ring)
local huntRingAnchor = nil   -- Part invisible anclada en el HRP del target
local huntRingAtt    = nil   -- Attachment en ese anchor (equivalente a Attachment1Ring)
local huntRingParts  = {}    -- {part, attPart, alignPart} lanzadas al target
local _huntRingDt    = 0
local _huntRingInterval = 1/15  -- 15fps igual que el ring
local _HUNT_RING_MAX = 40        -- max piezas simultáneas hacia el target

local function _cleanHuntRing()
    for _, entry in ipairs(huntRingParts) do
        pcall(function()
            if entry.att   and entry.att.Parent   then entry.att:Destroy()   end
            if entry.align and entry.align.Parent  then entry.align:Destroy() end
            -- Restaurar física normal a la pieza
            if entry.part and entry.part.Parent then
                entry.part.CanCollide = false  -- queda en partsRing, se maneja allí
            end
        end)
    end
    huntRingParts = {}
    if huntRingAnchor and huntRingAnchor.Parent then huntRingAnchor:Destroy() end
    if huntRingAtt    and huntRingAtt.Parent    then huntRingAtt:Destroy()    end
    huntRingAnchor = nil
    huntRingAtt    = nil
end

local function stopHunt()
    hunting = false
    _cleanHuntRing()
    if connections.hunt then connections.hunt:Disconnect() connections.hunt = nil end
    if connections.huntNoclip then connections.huntNoclip:Disconnect() connections.huntNoclip = nil end
    if connections.huntRing   then connections.huntRing:Disconnect()   connections.huntRing   = nil end
    if huntHighlight then huntHighlight:Destroy() huntHighlight = nil end
    if huntBeam then huntBeam:Destroy() huntBeam = nil end
    if att0 then att0:Destroy() att0 = nil end
    if att1 then att1:Destroy() att1 = nil end
    pcall(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local bv = hrp:FindFirstChild("HUNT_BV")
            local bav = hrp:FindFirstChild("HUNT_BAV")
            if bv then bv:Destroy() end
            if bav then bav:Destroy() end
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    pcall(function()
        local char = player.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = true end
            end
        end
    end)
    huntTarget = nil
end

local function startHunt(targetPlayer)
    stopHunt()
    huntTarget = targetPlayer
    if not huntTarget then return end
    hunting = true
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title="TOXIC HUNTER 🪐", Text="Fling imparable: " .. huntTarget.Name, Duration=3})
    end)
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then stopHunt() return end
    local oldCFrame = hrp.CFrame
    local bv = Instance.new("BodyVelocity", hrp)
    bv.Name = "HUNT_BV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    local bav = Instance.new("BodyAngularVelocity", hrp)
    bav.Name = "HUNT_BAV"
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(999999999, 999999999, 999999999)
    -- ★ FIX HUNT NOCLIP: Cachear partes en vez de GetDescendants() cada Stepped
    local _huntNoclipParts = {}
    local function _refreshHuntNoclipCache()
        _huntNoclipParts = {}
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then table.insert(_huntNoclipParts, v) end
        end
    end
    _refreshHuntNoclipCache()
    local _huntCacheConn = char.DescendantAdded:Connect(function(v)
        if v:IsA("BasePart") then table.insert(_huntNoclipParts, v) end
    end)

    connections.huntNoclip = RunService.Stepped:Connect(function()
        if not hunting then _huntCacheConn:Disconnect() return end
        pcall(function()
            for _, v in ipairs(_huntNoclipParts) do
                if v and v.Parent then v.CanCollide = false end
            end
        end)
    end)
    att0 = Instance.new("Attachment", hrp)
    huntBeam = Instance.new("Beam", hrp)
    huntBeam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
    huntBeam.FaceCamera = true
    huntBeam.Width0 = 0.5
    huntBeam.Width1 = 0.5
    huntBeam.Transparency = NumberSequence.new(0.3)
    huntBeam.Attachment0 = att0
    pcall(function() hrp.CFrame = CFrame.new(oldCFrame.Position + Vector3.new(0, 500, 0)) end)
    task.wait(0.05)
    -- ★ HUNT RING: anchor invisible en el HRP del target
    huntRingAnchor = Instance.new("Part", Workspace)
    huntRingAnchor.Name        = "PULPI_HUNT_RING_ANCHOR"
    huntRingAnchor.Anchored    = true
    huntRingAnchor.CanCollide  = false
    huntRingAnchor.Transparency = 1
    huntRingAnchor.Size        = Vector3.new(1, 1, 1)
    huntRingAtt = Instance.new("Attachment", huntRingAnchor)

    -- Heartbeat del hunt ring: recluta piezas sueltas de partsRing y las lanza al target
    -- Misma mecánica que ForcePart: AlignPosition apuntando a huntRingAtt
    connections.huntRing = RunService.Heartbeat:Connect(function(dt)
        if not hunting then return end
        _huntRingDt = _huntRingDt + dt
        if _huntRingDt < _huntRingInterval then return end
        _huntRingDt = 0

        -- Mover el anchor al HRP del target
        local tChar2 = huntTarget and huntTarget.Character
        local tHrp2  = tChar2 and tChar2:FindFirstChild("HumanoidRootPart")
        if not tHrp2 then return end
        pcall(function() huntRingAnchor.CFrame = tHrp2.CFrame end)

        -- Limpiar piezas ya destruidas del registro
        for i = #huntRingParts, 1, -1 do
            local e = huntRingParts[i]
            if not e.part or not e.part.Parent then
                pcall(function()
                    if e.att   and e.att.Parent   then e.att:Destroy()   end
                    if e.align and e.align.Parent  then e.align:Destroy() end
                end)
                table.remove(huntRingParts, i)
            end
        end

        -- Si ya tenemos suficientes piezas lanzadas, no reclutar más
        if #huntRingParts >= _HUNT_RING_MAX then return end

        -- Índice para llevar cuenta de dónde estamos en partsRing sin resetear cada frame
        local needed = _HUNT_RING_MAX - #huntRingParts
        local added  = 0

        -- Conjunto rápido de piezas ya reclutadas (evitar duplicados)
        local alreadyIn = {}
        for _, e in ipairs(huntRingParts) do
            if e.part then alreadyIn[e.part] = true end
        end

        local tPos = tHrp2.Position
        for i = #partsRing, 1, -1 do
            if added >= needed then break end
            local p = partsRing[i]
            if p and p.Parent and not p.Anchored and not alreadyIn[p] then
                -- Solo reclutar piezas dentro de 200 studs del target
                local d = (p.Position - tPos).Magnitude
                if d < 200 then
                    pcall(function()
                        -- Limpiar fuerzas previas (igual que ForcePart)
                        for _, x in pairs(p:GetChildren()) do
                            if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or
                               x:IsA("BodyGyro") or x:IsA("BodyPosition") or
                               x:IsA("BodyThrust") or x:IsA("BodyVelocity") or
                               x:IsA("RocketPropulsion") or x:IsA("AlignPosition") then
                                x:Destroy()
                            end
                        end
                        -- Limpiar attachments propios de ring previos
                        for _, x in pairs(p:GetChildren()) do
                            if x:IsA("Attachment") then x:Destroy() end
                        end
                        p.CanCollide = false
                        p.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                        -- Torque para que gire (como ForcePart)
                        local torq = Instance.new("Torque", p)
                        torq.Torque = Vector3.new(100000, 100000, 100000)
                        local attP = Instance.new("Attachment", p)
                        torq.Attachment0 = attP
                        -- AlignPosition apuntando al anchor del target
                        local alP = Instance.new("AlignPosition", p)
                        alP.MaxForce      = 9999999999999999
                        alP.MaxVelocity   = math.huge
                        alP.Responsiveness = 200
                        alP.Attachment0   = attP
                        alP.Attachment1   = huntRingAtt
                        table.insert(huntRingParts, {part=p, att=attP, align=alP, torque=torq})
                        alreadyIn[p] = true
                        added = added + 1
                    end)
                end
            end
        end
    end)

    connections.hunt = RunService.Heartbeat:Connect(function(dt)
        if not hunting then return end
        if not huntTarget or not huntTarget.Parent then
            stopHunt()
            pcall(function() hrp.CFrame = oldCFrame end)
            return
        end
        pcall(function()
            local tChar = huntTarget.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")
            if tHrp and tHum and tHum.Health > 0 then
                if not tChar:FindFirstChild("HUNT_ESP") then
                    huntHighlight = Instance.new("Highlight", tChar)
                    huntHighlight.Name = "HUNT_ESP"
                    huntHighlight.FillColor = Color3.fromRGB(255, 0, 0)
                    huntHighlight.FillTransparency = 0.5
                    huntHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
                if not att1 or att1.Parent ~= tHrp then
                    if att1 then att1:Destroy() end
                    att1 = Instance.new("Attachment", tHrp)
                    huntBeam.Attachment1 = att1
                end
                bav.AngularVelocity = Vector3.new(999999999, 999999999, 999999999)
                bv.Velocity = Vector3.zero
                hrp.CFrame = tHrp.CFrame
                hrp.AssemblyAngularVelocity = Vector3.new(999999999, 999999999, 999999999)
                hrp.AssemblyLinearVelocity = Vector3.zero
                pcall(function() tHrp.AssemblyAngularVelocity = Vector3.new(999999999, 999999999, 999999999) end)
            else
                stopHunt()
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hrp.CFrame = oldCFrame
                end)
                pcall(function()
                    StarterGui:SetCore("SendNotification", {Title="TOXIC HUNTER", Text="Victima Eliminada. 💀", Duration=3})
                end)
            end
        end)
    end)
end

